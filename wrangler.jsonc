{
  "name": "allen-mind-lab",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-10",

  "build": {
    "command": "node build-dist.mjs"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aml-infection-control-pilot",
      "database_id": "89114e21-2e9d-431a-ad61-cee8ccacf08f"
    }
  ]
}

// AML automatic deployment
